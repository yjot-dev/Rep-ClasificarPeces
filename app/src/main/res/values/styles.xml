<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilo para Títulos -->
    <style name="TextViewTitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Estilo para Subtitulos -->
    <style name="TextViewSubtitle" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">28sp</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Estilo para Textos -->
    <style name="TextViewMultiLine" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:maxLines">3</item>
        <item name="android:singleLine">false</item>
        <item name="android:inputType">textMultiLine</item>
    </style>

    <style name="TextViewOneLine" parent="Widget.MaterialComponents.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textAlignment">textStart</item>
    </style>

    <!-- Estilo para EditText -->
    <style name="EditTextFilledBox" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="android:textSize">24sp</item>
        <item name="android:textAlignment">textStart</item>
        <item name="android:inputType">text</item>
    </style>

    <!-- Estilo para Botones -->
    <style name="Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">20dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
    </style>
</resources>