<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startFragment">

    <fragment
        android:id="@+id/startFragment"
        android:name="com.yjotdev.clasificarpeces.presentation.mvvm.ui.fragment.StartFragment"
        tools:layout="@layout/fragment_start">
        <action
            android:id="@+id/action_start_to_species"
            app:destination="@id/speciesFragment" />
    </fragment>

    <fragment
        android:id="@+id/speciesFragment"
        android:name="com.yjotdev.clasificarpeces.presentation.mvvm.ui.fragment.SpeciesFragment"
        android:label="@string/speciesview_title"
        tools:layout="@layout/fragment_species">
        <action
            android:id="@+id/action_species_to_info"
            app:destination="@id/infoFragment" />
    </fragment>

    <fragment
        android:id="@+id/infoFragment"
        android:name="com.yjotdev.clasificarpeces.presentation.mvvm.ui.fragment.InfoFragment"
        android:label="@string/infoview_title"
        tools:layout="@layout/fragment_info" />
</navigation>